# Use a unique random value of at least 32 characters outside local development.
PHSS_SESSION_SECRET=replace-with-a-long-random-secret-before-deployment

# Signed-in session lifetime in seconds. Allowed range: 900 to 604800.
PHSS_SESSION_TTL_SECONDS=28800

# Local SQLite database. A missing database is initialized automatically.
PHSS_DATABASE_FILE=./data/phss.sqlite

# Optional one-time JSON import source used only when the SQLite database is empty.
# When omitted, data/store.json is preferred if present, then data/seed.json.
# PHSS_DATA_FILE=./data/store.json
